rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============ HELPER FUNCTIONS ============
    function isSignedIn() {
      return request.auth != null;
    }
    // Read role directly from the user's own document (no custom claims needed)
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return getUserRole() == 'admin';
    }
    function isManager() {
      return getUserRole() == 'management';
    }
    function isAdviser() {
      return getUserRole() == 'adviser';
    }
    function hasMgmtAccess() {
      return isAdmin() || isManager();
    }

    // ============ USERS / ADVISERS ============
    match /users/{userId} {
      // Anonymous `get` of a SINGLE user doc is allowed so the public QR capture
      // page can show the adviser's name. `list` stays restricted to signed-in
      // users so the adviser directory cannot be enumerated publicly.
      allow get: if true;
      allow list: if isSignedIn();
      // Admin or Management can create/update/delete users.
      // A freshly-created user may also create their OWN record (role restricted
      // to 'adviser') so the in-app "Add Adviser" flow can write the doc while
      // temporarily signed in as the new user.
      allow create: if hasMgmtAccess() ||
        (request.auth.uid == userId && request.resource.data.role == 'adviser');
      allow update, delete: if hasMgmtAccess();
    }

    // ============ ACTIVITIES ============
    match /activities/{actId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if hasMgmtAccess();
    }

    // ============ LEADS ============
    match /leads/{leadId} {
      // Mgmt: full access. Adviser: read/write only own assigned leads
      allow get, list: if hasMgmtAccess() ||
        (isAdviser() && resource.data.assignedAdviser == request.auth.uid);

      // Public QR capture: anonymous clients may CREATE a lead, but ONLY under
      // strict constraints so they cannot tamper with attribution or fake revenue:
      //  - status must be 'new'
      //  - assignedAdviser must point to a REAL adviser account (role check)
      //  - settlementAmount / annualPremium must be 0 (no fake commission)
      //  - method/channel fixed to 'QR Code'
      allow create: if hasMgmtAccess() ||
        (isAdviser() && request.resource.data.assignedAdviser == request.auth.uid) ||
        (request.auth == null
          && request.resource.data.status == 'new'
          && request.resource.data.assignedAdviser == request.resource.data.assignedAdviser
          && get(/databases/$(database)/documents/users/$(request.resource.data.assignedAdviser)).data.role == 'adviser'
          && request.resource.data.firstTouch.method == 'QR Code'
          && (request.resource.data.settlementAmount == 0 || request.resource.data.settlementAmount == null)
          && (request.resource.data.annualPremium == 0 || request.resource.data.annualPremium == null));

      allow update: if hasMgmtAccess() ||
        (isAdviser() && resource.data.assignedAdviser == request.auth.uid);
      // Management (and admin) may delete leads. Advisers cannot delete (only update their own).
      allow delete: if hasMgmtAccess();
    }

    // ============ WECHAT RECORDS ============
    match /wechat_records/{recId} {
      allow get, list: if hasMgmtAccess() || isAdviser();
      allow create, update: if hasMgmtAccess() || isAdviser();
      allow delete: if isAdmin();
    }

    // ============ SYSTEM SETTINGS ============
    match /settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
