rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============ HELPER FUNCTIONS ============
    function isSignedIn() {
      return request.auth != null;
    }
    // Role-based checks (active once Cloud Functions deploy sets custom claims)
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }
    function isManager() {
      return request.auth.token.role == 'management';
    }
    function isAdviser() {
      return request.auth.token.role == 'adviser';
    }
    function hasMgmtAccess() {
      return isAdmin() || isManager();
    }

    // ============ USERS / ADVISERS ============
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ============ ACTIVITIES ============
    match /activities/{actId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // ============ LEADS ============
    match /leads/{leadId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ============ WECHAT RECORDS ============
    match /wechat_records/{recId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ============ SYSTEM SETTINGS ============
    match /settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
